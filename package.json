{
  "name": "butchr-servr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback control panel for Butchr authorizations, deployment sessions and remote briefs",
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test ./test",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit && bun node_modules/typescript/bin/tsc -p tsconfig.web.json --noEmit",
    "build:web": "bun run verify:providers && bun scripts/build-web.ts",
    "build:providers": "bun scripts/build-provider-process.ts",
    "verify:providers": "bun scripts/verify-provider-process.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3",
    "@happy-dom/global-registrator": "20.14.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@brooswit/drovr": "https://github.com/brooswit-factory/drovr/releases/download/v0.16.11/brooswit-drovr-0.16.11.tgz",
    "@brooswit/drovr-events": "file:vendor/butchr/vendor/brooswit-drovr-freeze.tgz",
    "@brooswit/thatch": "0.8.0"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "license": "MIT",
  "dependencies": {
    "@launchpad-ui/components": "0.25.0",
    "@launchpad-ui/icons": "0.26.7",
    "@launchpad-ui/tokens": "0.19.0",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "react-stately": "3.50.0",
    "@brooswit/sundry": "0.2.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "style-mod": "4.1.4",
    "jira.js": "6.2.0",
    "confluence.js": "3.2.0"
  },
  "overrides": {
    "@brooswit/herdr-sdk": "0.3.0"
  }
}
